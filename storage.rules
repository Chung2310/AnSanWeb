
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Cho phép mọi người đọc các tệp tin (hình ảnh sản phẩm, bài viết...)
    match /{allPaths=**} {
      allow read: if true;
      
      // Chỉ cho phép ghi (tải lên, xóa, sửa) nếu đã đăng nhập và email là admin@ansan.com
      // Lưu ý: Đảm bảo bạn đã đăng nhập đúng email này trong trang /login
      allow write: if request.auth != null && request.auth.token.email == 'admin@ansan.com';
    }
  }
}
