# =========================================================================
# ANSANWEB ENVIRONMENT VARIABLES TEMPLATE
# =========================================================================

# -------------------------------------------------------------------------
# 1. FRONTEND CONFIGURATIONS (Next.js)
# -------------------------------------------------------------------------
# Cổng chạy ứng dụng Frontend (Next.js)
PORT=3006
HOST_PORT=3006

# URL của Backend API để Frontend gọi đến
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1


# -------------------------------------------------------------------------
# 2. BACKEND CONFIGURATIONS (Express)
# -------------------------------------------------------------------------
# Môi trường chạy ứng dụng (development / production)
NODE_ENV=development

# Cổng chạy ứng dụng Backend (Express)
BACKEND_PORT=3001

# Danh sách URL Frontend được phép gọi API (CORS), cách nhau bằng dấu phẩy
LINK_COR=http://localhost:3006,http://localhost:9002


# -------------------------------------------------------------------------
# 3. DATABASE CONFIGURATIONS (MongoDB)
# -------------------------------------------------------------------------
# Địa chỉ kết nối đến cơ sở dữ liệu MongoDB
MONGODB_URI=mongodb://localhost:27017/ansanweb


# -------------------------------------------------------------------------
# 4. CLOUDINARY CONFIGURATIONS (Image Storage)
# -------------------------------------------------------------------------
# Thông tin cấu hình lưu trữ ảnh Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret


# -------------------------------------------------------------------------
# 5. SECURITY CONFIGURATIONS (JWT Tokens)
# -------------------------------------------------------------------------
# Khóa bí mật dùng để ký và xác thực mã Access Token (Khuyên dùng chuỗi ngẫu nhiên dài)
JWT_ACCESS_SECRET=your_jwt_access_token_secret_key_here_minimum_32_characters

# Khóa bí mật dùng để ký và xác thực mã Refresh Token (Khuyên dùng chuỗi ngẫu nhiên dài)
JWT_REFRESH_SECRET=your_jwt_refresh_token_secret_key_here_minimum_32_characters


# -------------------------------------------------------------------------
# 6. DOCKER DEPLOYMENT CONFIGURATIONS (CI/CD VPS)
# -------------------------------------------------------------------------
# Tên của mạng nội bộ Docker liên kết giữa ERP và Website
DOCKER_NETWORK=default_network
CONTAINER_NAME=ansanweb-production
BACKEND_CONTAINER_NAME=ansanweb-backend
IMAGE_NAME=ghcr.io/your_github_username/ansanweb
IMAGE_TAG=latest
