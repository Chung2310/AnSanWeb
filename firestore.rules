
/**
 * Core Philosophy: This ruleset implements a Role-Based Access Control (RBAC) model tailored for a content-driven website with an administrative backend. The core principle is a strict separation between publicly readable content and privately managed data. A user's administrative status, determined by the existence of their UID in a dedicated 'roles_admin' collection, is the sole factor for granting write access to any data.
 *
 * Data Structure: The database is organized into several flat, top-level collections.
 * - /products, /product_details, /categories, /blogPosts: These collections store public-facing content that anyone can read.
 * - /contacts, /newsletterSubscriptions: These collections store data submitted by users. They are write-only for the public and read-only for admins to protect user privacy.
 * - /roles_admin: A specialized collection acting as a high-performance lookup table for authorization. The existence of a document /roles_admin/{userId} grants that user administrative privileges across the entire database.
 *
 * Key Security Decisions:
 * - Admin-Centric Writes: All write operations (create, update, delete) on any data are restricted to authenticated users with an admin role.
 * - Public Read Access: Core content like products, categories, and blog posts is publicly readable to allow the website to function for all visitors, including those not signed in.
 * - Write-Only for User Submissions: To protect privacy, contact forms and newsletter subscriptions can be created by anyone but can only be viewed and managed by administrators.
 * - No User Data Ownership: The concept of individual user data ownership does not exist in this model, simplifying the rules significantly. All content is managed centrally by admins.
 *
 * Denormalization for Authorization: The /roles_admin/{userId} collection is a key example of denormalization for performance and security. Instead of looking up a role on a user profile document (requiring a costly 'get' call), rules perform a fast, non-billable 'exists()' check. This makes role verification efficient and isolates authorization logic from user profile data.
 *
 * Structural Segregation: Public content (like /products) is stored in separate collections from private user-submitted data (like /contacts). This clear separation allows for simple, collection-wide security rules (e.g., allow public list on /products, deny public list on /contacts) without needing complex conditions based on document fields.
 */
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    /**
     * Checks if a user is a designated administrator.
     * Admin status is granted by the existence of a document in the /roles_admin collection
     * where the document ID is the user's UID. This is a secure and performant way to check roles.
     */
    function isAdmin() {
      return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    /**
     * Verifies that a document being modified or deleted actually exists.
     * This prevents errors and ensures operations are intentional.
     */
    function isExistingDoc() {
      return resource != null;
    }
    
    /**
     * Checks if this is the very first admin role being created in the system.
     * It's true if the entire roles_admin collection is empty.
     */
    function isFirstAdminCreation() {
      // This is a more robust way to check for collection emptiness.
      // It checks if the size of the collection is 0.
      return get(/databases/$(database)/documents/roles_admin).size == 0;
    }

    /**
     * @description Publicly readable product data (core info). Only admins can manage (create, update, delete) product entries.
     * @path /products/{productId}
     */
    match /products/{productId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    /**
     * @description Publicly readable product detail data. Only admins can manage.
     * @path /product_details/{productId}
     */
    match /product_details/{productId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    /**
     * @description Publicly readable category data. Only admins can manage categories.
     * @path /categories/{categoryId}
     */
    match /categories/{categoryId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    /**
     * @description Publicly readable blog posts. Only admins can publish or manage posts.
     * @path /blogPosts/{blogPostId}
     */
    match /blogPosts/{blogPostId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    /**
     * @description Stores contact form submissions. Anyone can submit a message, but only admins can read or manage them.
     * @path /contacts/{contactId}
     */
    match /contacts/{contactId} {
      allow get, list: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    /**
     * @description Stores newsletter email subscriptions. Anyone can subscribe, but only admins can view or manage the subscription list.
     * @path /newsletterSubscriptions/{newsletterSubscriptionId}
     */
    match /newsletterSubscriptions/{newsletterSubscriptionId} {
      allow get, list: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    /**
     * @description Manages administrator roles. Any authenticated user can create their OWN admin role document.
     * This is a temporary, broader rule to allow the first admin to self-assign their role.
     * IMPORTANT: This rule should be tightened after the first admin is created.
     * Only existing admins should be able to grant or revoke admin roles.
     * @path /roles_admin/{userId}
     */
     match /roles_admin/{userId} {
      allow get, list: if isAdmin();
      // Temporarily allow any authenticated user to create their own admin role document.
      allow create: if request.auth.uid == userId && request.auth != null;
      allow update, delete: if isAdmin();
    }
  }
}

service firebase.storage {
  match /b/{bucket}/o {
    // Allow public read access to all files.
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
