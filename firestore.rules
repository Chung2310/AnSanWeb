
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'admin@ansan.com';
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /products/{productId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }
    
    match /categories/{categoryId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }
    
    match /product_details/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /blogPosts/{blogPostId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /contacts/{contactId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /newsletterSubscriptions/{subscriptionId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // This collection is no longer needed for auth checks
    match /roles_admin/{userId} {
      allow read, write: if false;
    }
  }
}
