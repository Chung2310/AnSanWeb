
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAdmin() {
      return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    // Products can be read by anyone, but only written by admins.
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Product details can be read by anyone, but only written by admins.
     match /product_details/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Categories can be read by anyone, but only written by admins.
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Blog posts can be read by anyone, but only written by admins.
    match /blogPosts/{blogPostId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Contact messages can only be created by anyone, but only read/deleted by admins.
    match /contacts/{contactId} {
      allow read, delete: if isAdmin();
      allow create: if true;
    }
    
    // Newsletter subscriptions can be created by anyone, but only read by admins.
    match /newsletterSubscriptions/{subId} {
        allow read: if isAdmin();
        allow create: if true;
    }

    // Only admins can read/write to the admin roles collection.
    // As a special bootstrap rule, an authenticated user can create their own admin entry.
    // THIS SHOULD BE TIGHTENED to `allow create: if isAdmin();` after the first admin is created.
    match /roles_admin/{userId} {
      allow read, write: if isAdmin();
      allow create: if request.auth.uid == userId;
    }

    // Default deny all other reads/writes
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

service firebase.storage {
  match /b/{bucket}/o {
    // Allow public read on all files
    allow read: if true;
    
    // Allow write only for authenticated users (admins)
    match /{allPaths=**} {
      allow write: if request.auth != null;
    }
  }
}
