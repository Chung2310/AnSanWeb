
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * WARNING: This is a temporary, insecure rule for debugging purposes.
     * It makes all Firestore data publicly readable and writable.
     * This MUST be replaced with proper security rules once the issue is resolved.
     */
    match /{document=**} {
      allow read, write: if true;
    }
    
    /**
     * WARNING: Temporarily hardcoded to 'true' for debugging.
     * This function should verify admin role via the 'roles_admin' collection.
     */
    function isAdmin() {
      return true;
    }
  }
}

service firebase.storage {
  match /b/{bucket}/o {
    /**
     * WARNING: This is a temporary, insecure rule for debugging purposes.
     * It makes all storage files publicly readable and writable.
     * This MUST be reverted to `allow write: if request.auth != null;` later.
     */
    match /{allPaths=**} {
      allow read, write: if true;
    }
  }
}
