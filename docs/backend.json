        "id": {
          "type": "string",
          "description": "Unique identifier for the BlogPost entity."
        },
        "titleVN": {
          "type": "string",
          "description": "Blog post title in Vietnamese."
        },
        "titleEN": {
          "type": "string",
          "description": "Blog post title in English."
        },
        "slug": {
          "type": "string",
          "description": "URL-friendly slug for the blog post."
        },
        "contentVN": {
          "type": "string",
          "description": "Blog post content in Vietnamese."
        },
        "contentEN": {
          "type": "string",
          "description": "Blog post content in English."
        },
        "image": {
          "type": "string",
          "description": "URL of the blog post image."
        },
        "author": {
          "type": "string",
          "description": "Author of the blog post."
        },
        "date": {
          "type": "string",
          "description": "Date of the blog post.",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "titleVN",
        "titleEN",
        "slug",
        "contentVN",
        "contentEN",
        "image",
        "author",
        "date"
      ]
