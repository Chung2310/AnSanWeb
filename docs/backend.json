{
  "entities": {
    "Wine": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Wine",
      "type": "object",
      "description": "Represents a wine product with its details.",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the wine product." },
        "nameVN": { "type": "string", "description": "Wine name in Vietnamese." },
        "nameEN": { "type": "string", "description": "Wine name in English." },
        "slug": { "type": "string", "description": "URL-friendly slug for the wine." },
        "description": { "type": "string", "description": "Wine description." },
        "price": { "type": "number", "description": "Price of the wine." },
        "image": { "$ref": "#/backend/entities/ImageInfo" },
        "isFeatured": { "type": "boolean", "description": "Indicates if the wine is featured." },
        "isNew": { "type": "boolean", "description": "Indicates if the wine is a new arrival." },
        "categoryIds": { "type": "array", "items": { "type": "string" }, "description": "Array of category IDs." },
        "attributes": { "type": "array", "items": { "$ref": "#/backend/entities/ProductAttribute" } },
        "tags": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string", "enum": ["published", "draft"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "nameVN", "slug", "price", "status"]
    },
    "Category": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Category",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "inactive"] }
      },
      "required": ["id", "name", "slug", "status"]
    },
    "BlogPost": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "BlogPost",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "author": { "type": "string" },
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "excerpt": { "type": "string" },
        "content": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "image": { "$ref": "#/backend/entities/ImageInfo" },
        "categories": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["id", "author", "title", "slug", "excerpt", "date", "categories"]
    },
    "ProductAttribute": {
      "title": "ProductAttribute",
      "type": "object",
      "properties": {
        "label": { "type": "string" },
        "value": { "type": "string" }
      },
      "required": ["label", "value"]
    },
    "ImageInfo": {
      "title": "ImageInfo",
      "type": "object",
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "path": { "type": "string" }
      },
      "required": ["url", "path"]
    },
    "AdminRole": {
      "title": "AdminRole",
      "type": "object",
      "properties": {
        "role": { "type": "string", "enum": ["admin"] }
      },
      "required": ["role"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/products/{productId}",
        "definition": {
          "schema": { "$ref": "#/backend/entities/Wine" },
          "description": "Stores wine product information."
        }
      },
      {
        "path": "/categories/{categoryId}",
        "definition": {
          "schema": { "$ref": "#/backend/entities/Category" },
          "description": "Stores wine categories."
        }
      },
      {
        "path": "/blogPosts/{blogPostId}",
        "definition": {
          "schema": { "$ref": "#/backend/entities/BlogPost" },
          "description": "Stores blog post information."
        }
      },
      {
        "path": "/roles_admin/{userId}",
        "definition": {
          "schema": { "$ref": "#/backend/entities/AdminRole" },
          "description": "Stores admin user roles. Writable only by backend functions, readable by the user themselves to verify their role."
        }
      }
    ]
  }
}
