
{
  "entities": {
    "Wine": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Wine",
      "type": "object",
      "description": "Represents a wine product.",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the wine product." },
        "nameVN": { "type": "string", "description": "Wine name in Vietnamese." },
        "slug": { "type": "string", "description": "URL-friendly slug for the wine product." },
        "shortDescription": { "type": "string", "description": "A brief summary of the product, displayed under the title on the detail page." },
        "price": { "type": "number", "description": "Price of the wine." },
        "priceDescription": { "type": "string", "description": "A description for the main price, e.g., '/ bottle'." },
        "secondaryPrice": { "type": ["number", "null"], "description": "The original price, used to show discounts. Should be higher than price." },
        "secondaryPriceDescription": { "type": ["string", "null"], "description": "A description for the secondary price, e.g., '/ case'." },
        "description": { "type": "string", "description": "Detailed description for the wine product." },
        "image": { "type": "object", "properties": { "url": { "type": "string" }, "path": { "type": "string" } } },
        "isFeatured": { "type": "boolean", "description": "Indicates if the wine is featured." },
        "isNew": { "type": "boolean", "description": "Indicates if the wine is a new arrival." },
        "bestChoice": { "type": "boolean", "description": "Indicates if the wine is a best choice." },
        "isGoodPrice": { "type": "boolean", "description": "Indicates if the wine has a good price." },
        "status": { "type": "string", "enum": ["published", "draft"] },
        "tags": { "type": "array", "items": { "type": "string" }, "description": "Holds the category IDs" },
        "attributes": { 
          "type": "array", 
          "items": { 
            "type": "object", 
            "properties": { "label": { "type": "string" }, "value": { "type": "string" } }
          } 
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "nameVN", "slug", "price", "status"]
    },
    "Category": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Category",
      "type": "object",
      "description": "Represents a category of wines, which can be hierarchical.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "parentId": { "type": ["string", "null"], "description": "The ID of the parent category, if any." },
        "description": { "type": "string", "description": "A detailed HTML-enabled description of the category." },
        "tags": { "type": "array", "items": { "type": "string" }, "description": "Holds classification tag IDs (e.g., from mega menu data)." }
      },
      "required": ["id", "name", "slug"]
    },
    "BlogPost": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "BlogPost",
      "type": "object",
      "description": "Represents a blog post or article.",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "excerpt": { "type": "string" },
        "content": { "type": "string" },
        "image": { "type": "object", "properties": { "url": { "type": "string" }, "path": { "type": "string" } } },
        "author": { "type": "string" },
        "categories": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "slug", "excerpt", "author", "categories"]
    },
    "Contact": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Contact",
      "type": "object",
      "description": "Represents a contact message from a user.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "message": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "email", "message", "createdAt"]
    },
    "AppConfig": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "AppConfig",
      "type": "object",
      "description": "Stores global application configuration and settings.",
      "properties": {
        "id": { "type": "string" },
        "popup": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "imageUrl": { "type": "string" },
            "targetUrl": { "type": "string" },
            "delay": { "type": "number" }
          }
        },
        "heroBanners": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "imageUrl": { "type": "string" },
              "label": { "type": "string" },
              "title": { "type": "string" },
              "description": { "type": "string" },
              "href": { "type": "string" }
            }
          }
        }
      }
    }
  },
  "auth": {
    "providers": [
      "password"
    ]
  },
  "firestore": {
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Wine" },
      "description": "Stores all wine product information, including listing and detail data."
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Stores product categories in a hierarchical structure."
    },
    "/blogPosts/{blogPostId}": {
      "schema": { "$ref": "#/entities/BlogPost" },
      "description": "Stores blog posts."
    },
    "/contacts/{contactId}": {
      "schema": { "$ref": "#/entities/Contact" },
      "description": "Stores contact form submissions."
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/AppConfig" },
      "description": "Global application settings."
    }
  }
}
