{
  "entities": {
    "Wine": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Wine",
      "type": "object",
      "description": "Represents a wine product.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Wine entity."
        },
        "nameVN": {
          "type": "string",
          "description": "Wine name in Vietnamese."
        },
        "nameEN": {
          "type": "string",
          "description": "Wine name in English."
        },
        "slug": {
          "type": "string",
          "description": "URL-friendly slug for the wine."
        },
        "descriptionVN": {
          "type": "string",
          "description": "Wine description in Vietnamese."
        },
        "descriptionEN": {
          "type": "string",
          "description": "Wine description in English."
        },
        "price": {
          "type": "number",
          "description": "Price of the wine."
        },
        "origin": {
          "type": "string",
          "description": "Origin country of the wine."
        },
        "type": {
          "type": "string",
          "description": "Type of wine (e.g., Red, White, Rosé)."
        },
        "vintage": {
          "type": "number",
          "description": "Vintage year of the wine."
        },
        "alcohol": {
          "type": "number",
          "description": "Alcohol percentage of the wine."
        },
        "volume": {
          "type": "number",
          "description": "Volume of the wine bottle (in ml)."
        },
        "images": {
          "type": "array",
          "description": "Array of image URLs for the wine.",
          "items": {
            "type": "string"
          }
        },
        "rating": {
          "type": "number",
          "description": "Customer rating of the wine."
        },
        "isFeatured": {
          "type": "boolean",
          "description": "Indicates if the wine is featured."
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp of when the wine was created.",
          "format": "date-time"
        },
        "categoryIds": {
          "type": "array",
          "description": "References to Categories. (Relationship: Category N:N Wine)",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "nameVN",
        "nameEN",
        "slug",
        "descriptionVN",
        "descriptionEN",
        "price",
        "origin",
        "type",
        "vintage",
        "alcohol",
        "volume",
        "images",
        "rating",
        "isFeatured",
        "createdAt"
      ]
    },
    "Category": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Category",
      "type": "object",
      "description": "Represents a category of wine.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Category entity."
        },
        "nameVN": {
          "type": "string",
          "description": "Category name in Vietnamese."
        },
        "nameEN": {
          "type": "string",
          "description": "Category name in English."
        },
        "slug": {
          "type": "string",
          "description": "URL-friendly slug for the category."
        },
        "description": {
          "type": "string",
          "description": "Category description."
        },
        "image": {
          "type": "string",
          "description": "URL of the category image."
        }
      },
      "required": [
        "id",
        "nameVN",
        "nameEN",
        "slug",
        "description",
        "image"
      ]
    },
    "BlogPost": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "BlogPost",
